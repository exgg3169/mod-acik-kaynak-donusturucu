<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VENOM EXECUTOR"
        android:textSize="20sp"
        android:textColor="#FF0000"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Target: com.sandboxol.blockymods"
        android:textSize="10sp"
        android:textColor="#888888"
        android:gravity="center"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/scriptEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:hint="-- Lua script buraya...\nlog('hello from venom')\nlocal pid = get_pid()\nlog('target pid: ' .. pid)"
        android:hintTextColor="#444444"
        android:background="#1A1A1A"
        android:textColor="#00FF00"
        android:textSize="13sp"
        android:typeface="monospace"
        android:padding="10dp"
        android:scrollbars="vertical"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/executeBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="EXECUTE"
            android:textColor="#000000"
            android:backgroundTint="#00CC00"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/injectBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="INJECT"
            android:textColor="#FFFFFF"
            android:backgroundTint="#CC0000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/loadScriptBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="LOAD SCRIPT"
            android:textColor="#FFFFFF"
            android:backgroundTint="#005580"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/pidBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="PID"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333399"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/resetBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="RESET LUA"
            android:textColor="#FFFFFF"
            android:backgroundTint="#996600"
            android:textSize="11sp"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <!-- APK Patcher Panel — göster sadece root yoksa -->
    <LinearLayout
        android:id="@+id/patcherPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:background="#1A0A00"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ APK PATCHER MODU (root yok)"
            android:textColor="#FFA500"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Blockymods APK dosyasını seç → patch et → kur"
            android:textColor="#888888"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/selectApkBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="SEÇ APK"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/patchApkBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="PATCH &amp; KUR"
                android:textColor="#000000"
                android:backgroundTint="#FFA500"
                android:textSize="11sp"
                android:textStyle="bold"
                android:enabled="false"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:id="@+id/outputScroll"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:background="#111111">

        <TextView
            android:id="@+id/outputArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:fontFamily="monospace"/>

    </ScrollView>

</LinearLayout>
